# =============================================================================
#  417 France — modèle de configuration. Copiez-le en .env.local et remplissez-le.
#  Lu par build.js et server.js au démarrage : relancez « npm start » après
#  chaque modification.
#  En ligne, recopiez les mêmes variables dans Vercel :
#  Project → Settings → Environment Variables, puis redéployez.
# =============================================================================


# ---------- Supabase : espace client et connexion au back-office ------------
#
# Où les trouver : supabase.com → votre projet → Project Settings → API
# (ou bouton « Connect » en haut du tableau de bord).

# Project URL, de la forme https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Clé publique du projet : « Publishable key » (sb_publishable_…)
# ou, sur un projet plus ancien, la clé « anon public » (eyJ…).
# Elle est faite pour être visible dans le navigateur.
# Ne mettez JAMAIS ici la clé « secret » ou « service_role ».
SUPABASE_PUBLISHABLE_KEY=


# ---------- Back-office --------------------------------------------------------

# Adresse de connexion au back-office. La première de la liste devient
# l'identifiant du compte « admin » : c'est elle qui ouvre /admin, avec le
# mot de passe ci-dessous. Séparées par des virgules.
ADMIN_EMAILS=contact@417france.com

# Mot de passe du back-office, appliqué au démarrage du serveur.
#   - 8 caractères au minimum, sinon il est ignoré (le serveur le signale) ;
#   - modifiez-le ici puis relancez « npm start » : la nouvelle valeur prend
#     effet immédiatement et l'ancienne cesse de fonctionner ;
#   - un mot de passe changé depuis le back-office n'est PAS écrasé au
#     redémarrage : tant que cette ligne ne bouge pas, c'est le vôtre qui reste ;
#   - laisser vide conserve le mot de passe déjà enregistré.
# Pour en poser un sans passer par ce fichier :
#   npm run password -- <nouveau mot de passe>
ADMIN_PASSWORD=


# ---------- Site ---------------------------------------------------------------

# Adresse publique du site, pour les URL canoniques et le sitemap.
# En local, laisser vide.
SITE_URL=


# ---------- À régler dans le tableau de bord Supabase (pas ici) ---------------
#
# 1. Authentication → URL Configuration
#      Site URL       : https://417fr-eta.vercel.app   (ou votre domaine)
#      Redirect URLs  : http://localhost:4170/**
#                       https://417fr-eta.vercel.app/**
#
# 2. Authentication → Sign In / Providers → Email : activé,
#    « Confirm email » activé (indispensable pour l'accès au back-office).
#
# 3. Authentication → Sign In / Providers → Google : activé, avec le
#    Client ID et le Client Secret créés dans Google Cloud Console
#    (APIs & Services → Credentials → OAuth client ID → Web application).
#    Dans Google Cloud, « Authorized redirect URIs » :
#      https://<votre-projet>.supabase.co/auth/v1/callback
#    Ces deux valeurs Google se collent dans Supabase, pas dans ce fichier.
